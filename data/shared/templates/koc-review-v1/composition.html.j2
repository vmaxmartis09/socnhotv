<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width={{ width }}, height={{ height }}, initial-scale=1.0" />
    <title>{{ data.product.title or data.product.name }}</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body, html { width: {{ width }}px; height: {{ height }}px; overflow: hidden; background: #020617; font-family: -apple-system, sans-serif; }
      #root { position: relative; width: {{ width }}px; height: {{ height }}px; overflow: hidden; }
      {{ styles_css }}
    </style>
  </head>
  <body>
    <div id="root"
         data-composition-id="main"
         data-start="0"
         data-duration="{{ total_duration }}"
         data-width="{{ width }}"
         data-height="{{ height }}">

      <!-- Header badge -->
      <div id="badge-top" class="review-badge-top clip" data-start="0" data-duration="{{ total_duration }}" data-track-index="2">
        🔍 {{ data.reviewer_badge or "SÓC NHỎ TEST & REVIEW" }}
      </div>

      <!-- Pros and Cons -->
      <div id="pros-cons" class="pros-cons-container clip" data-start="1.5" data-duration="{{ total_duration - 1.5 }}" data-track-index="2">
        <div class="card-item card-pros">✅ {{ data.pros_text }}</div>
        <div class="card-item card-cons">⚠️ {{ data.cons_text }}</div>
      </div>

      <!-- Rating Score -->
      <div id="rating-box" class="rating-pill clip" data-start="3.0" data-duration="{{ total_duration - 3.0 }}" data-track-index="2">
        {{ data.rating_score or "⭐⭐⭐⭐⭐ 9.5/10" }}
      </div>

      <audio id="audio-voiceover" class="clip" src="{{ voiceover_src }}" data-start="0" data-duration="{{ total_duration }}" data-track-index="3"></audio>
      {% if bgm_src %}
      <audio id="audio-bgm" class="clip" src="{{ bgm_src }}" data-start="0" data-duration="{{ total_duration }}" data-track-index="4" data-volume="0.16"></audio>
      {% endif %}
    </div>

    <script>
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });
      tl.fromTo("#badge-top", { y: -30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4 }, 0.1);
      tl.fromTo("#pros-cons", { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.45, ease: "power2.out" }, 1.5);
      tl.fromTo("#rating-box", { scale: 0.8, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.35, ease: "back.out(1.8)" }, 3.0);
      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
