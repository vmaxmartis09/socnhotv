<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width={{ width }}, height={{ height }}, initial-scale=1.0" />
    <title>{{ data.product.title or "KOC Review" }}</title>
    <script src="assets/gsap.min.js"></script>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body, html { width: {{ width }}px; height: {{ height }}px; overflow: hidden; background: #030712; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
      #root { position: relative; width: {{ width }}px; height: {{ height }}px; overflow: hidden; background: radial-gradient(circle at 50% 25%, #3b0764 0%, #030712 100%); }
      {{ styles_css }}
    </style>
  </head>
  <body>
    <div id="root"
         data-composition-id="main"
         data-start="0"
         data-duration="{{ total_duration }}"
         data-width="{{ width }}"
         data-height="{{ height }}">

      <!-- Header with KOC Profile -->
      <div id="koc-hdr" class="koc-header clip" data-start="0" data-duration="{{ total_duration }}" data-track-index="2">
        <div class="koc-badge-left">
          <div class="avatar-circle">
            <img src="assets/koc_avatar.png" class="avatar-img" alt="KOC Avatar" />
          </div>
          <div>
            <span class="koc-name">Sóc Nhỏ TV</span>
            <span class="verified-icon"> ✓</span>
          </div>
        </div>
        <div class="koc-rating-badge">9.8/10 ⭐</div>
      </div>

      <!-- Center Product Stage -->
      <div id="prod-stage" class="product-stage clip" data-start="0.3" data-duration="{{ total_duration - 0.3 }}" data-track-index="2">
        <div class="product-glow"></div>
        <img id="prod-img" src="assets/product.png" class="product-img" alt="Product" />
        <div class="product-meta">
          <div class="product-name">{{ data.product.title or "Tai Nghe Gaming Sóc Nhỏ Bass Pro" }}</div>
          <div class="product-price">490.000đ</div>
        </div>
      </div>

      <!-- Dynamic Synchronized Word Subtitles (Word-level timestamps from stt-align) -->
      <div id="sub-box" class="subtitles-container clip" data-start="0" data-duration="{{ total_duration }}" data-track-index="3">
        <span id="w1" class="word-span">Xin</span>
        <span id="w2" class="word-span">chào!</span>
        <span id="w3" class="word-span">Mình</span>
        <span id="w4" class="word-span">là</span>
        <span id="w5" class="word-span">Sóc</span>
        <span id="w6" class="word-span">Nhỏ</span>
        <span id="w7" class="word-span">TV</span>
        <span id="w8" class="word-span">đây!</span>
      </div>

      <!-- Pros and Cons Review Card -->
      <div id="review-card" class="review-card clip" data-start="2.0" data-duration="{{ total_duration - 2.0 }}" data-track-index="2">
        <div class="pros-box">
          <span>✓</span>
          <span>{{ data.pros_text or "Âm bass chắc khỏe, pin trâu 30 tiếng liên tục" }}</span>
        </div>
        <div class="cons-box">
          <span>✗</span>
          <span>{{ data.cons_text or "Hộp sạc hơi to một chút khi bỏ túi" }}</span>
        </div>
      </div>

      <audio id="audio-voiceover" class="clip" src="{{ voiceover_src or 'assets/voiceover.mp3' }}" data-start="0" data-duration="{{ total_duration }}" data-track-index="4"></audio>
    </div>

    <script>
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });

      // Header & product animations
      tl.fromTo("#koc-hdr", { y: -30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.35, ease: "power2.out" }, 0.1);
      tl.fromTo("#prod-stage", { scale: 0.8, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.45, ease: "back.out(1.6)" }, 0.3);
      tl.fromTo("#review-card", { y: 40, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: "power2.out" }, 2.0);

      // Word-level karaoke timing from Whisper stt-align:
      // "Xin" (0.0 -> 0.32)
      tl.to("#w1", { className: "word-span active", duration: 0.05 }, 0.05);
      tl.to("#w1", { className: "word-span", duration: 0.05 }, 0.32);

      // "chào!" (0.32 -> 0.74)
      tl.to("#w2", { className: "word-span active", duration: 0.05 }, 0.32);
      tl.to("#w2", { className: "word-span", duration: 0.05 }, 0.74);

      // "Mình" (0.86 -> 1.00)
      tl.to("#w3", { className: "word-span active", duration: 0.05 }, 0.86);
      tl.to("#w3", { className: "word-span", duration: 0.05 }, 1.00);

      // "là" (1.00 -> 1.14)
      tl.to("#w4", { className: "word-span active", duration: 0.05 }, 1.00);
      tl.to("#w4", { className: "word-span", duration: 0.05 }, 1.14);

      // "Sóc" (1.14 -> 1.38)
      tl.to("#w5", { className: "word-span active", duration: 0.05 }, 1.14);
      tl.to("#w5", { className: "word-span", duration: 0.05 }, 1.38);

      // "Nhỏ" (1.38 -> 1.58)
      tl.to("#w6", { className: "word-span active", duration: 0.05 }, 1.38);
      tl.to("#w6", { className: "word-span", duration: 0.05 }, 1.58);

      // "TV" (1.58 -> 1.84)
      tl.to("#w7", { className: "word-span active", duration: 0.05 }, 1.58);
      tl.to("#w7", { className: "word-span", duration: 0.05 }, 1.84);

      // "đây!" (1.84 -> 2.40)
      tl.to("#w8", { className: "word-span active", duration: 0.05 }, 1.84);
      tl.to("#w8", { className: "word-span", duration: 0.05 }, 2.40);

      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
