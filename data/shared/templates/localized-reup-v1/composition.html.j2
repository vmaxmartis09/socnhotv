<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width={{ width }}, height={{ height }}, initial-scale=1.0" />
    <title>{{ data.title }}</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body, html { width: {{ width }}px; height: {{ height }}px; overflow: hidden; background: #000; font-family: -apple-system, sans-serif; }
      #root { position: relative; width: {{ width }}px; height: {{ height }}px; overflow: hidden; }
      {{ styles_css }}
    </style>
  </head>
  <body>
    <div id="root"
         data-composition-id="main"
         data-start="0"
         data-duration="{{ total_duration }}"
         data-width="{{ width }}"
         data-height="{{ height }}">

      <!-- Brand frame -->
      <div class="brand-frame"></div>

      <!-- Header & Credit -->
      <div id="hdr" class="brand-header-pill clip" data-start="0" data-duration="{{ total_duration }}" data-track-index="2">
        SÓC NHỎ TV • BẢN ĐỊA HOÁ
      </div>
      <div id="credit" class="author-credit clip" data-start="0" data-duration="{{ total_duration }}" data-track-index="2">
        Nguồn: {{ data.source_author or "@creator" }}
      </div>

      <!-- Character commentary -->
      <div id="comment" class="character-comment-pill clip" data-start="1.0" data-duration="{{ total_duration - 1.0 }}" data-track-index="2">
        🐿️ {{ data.character_reaction }}
      </div>

      <audio id="audio-voiceover" class="clip" src="{{ voiceover_src }}" data-start="0" data-duration="{{ total_duration }}" data-track-index="3"></audio>
      {% if bgm_src %}
      <audio id="audio-bgm" class="clip" src="{{ bgm_src }}" data-start="0" data-duration="{{ total_duration }}" data-track-index="4" data-volume="0.14"></audio>
      {% endif %}
    </div>

    <script>
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });
      tl.fromTo("#hdr", { y: -30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4 }, 0.1);
      tl.fromTo("#comment", { y: 30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4, ease: "power2.out" }, 1.0);
      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
