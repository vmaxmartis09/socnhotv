<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width={{ width }}, height={{ height }}, initial-scale=1.0" />
    <title>{{ data.item_name }}</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body, html { width: {{ width }}px; height: {{ height }}px; overflow: hidden; background: #0a0a0a; font-family: -apple-system, sans-serif; }
      #root { position: relative; width: {{ width }}px; height: {{ height }}px; overflow: hidden; }
      {{ styles_css }}
    </style>
  </head>
  <body>
    <div id="root"
         data-composition-id="main"
         data-start="0"
         data-duration="{{ total_duration }}"
         data-width="{{ width }}"
         data-height="{{ height }}">

      <!-- Header -->
      <div id="hdr" class="unbox-header clip" data-start="0" data-duration="{{ total_duration }}" data-track-index="2">
        {{ data.title or "📦 CÙNG ĐẬP HỘP SIÊU PHẨM MỚI VỀ" }}
      </div>

      <!-- Countdown -->
      <div id="cd" class="countdown-badge clip" data-start="0.3" data-duration="2.5" data-track-index="2">
        ⏳ 3.. 2.. 1.. MỞ!
      </div>

      <!-- Detail Card (Punch-in) -->
      <div id="detail" class="detail-pill clip" data-start="2.0" data-duration="{{ total_duration - 2.0 }}" data-track-index="2">
        🔍 {{ data.first_impression }}
      </div>

      <audio id="audio-voiceover" class="clip" src="{{ voiceover_src }}" data-start="0" data-duration="{{ total_duration }}" data-track-index="3"></audio>
      {% if bgm_src %}
      <audio id="audio-bgm" class="clip" src="{{ bgm_src }}" data-start="0" data-duration="{{ total_duration }}" data-track-index="4" data-volume="0.16"></audio>
      {% endif %}
    </div>

    <script>
      window.__timelines = window.__timelines || {};
      const tl = gsap.timeline({ paused: true });
      tl.fromTo("#hdr", { y: -30, opacity: 0 }, { y: 0, opacity: 1, duration: 0.4 }, 0.1);
      tl.fromTo("#cd", { scale: 0.5, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.35, ease: "back.out(2)" }, 0.3);
      tl.fromTo("#detail", { scale: 0.85, opacity: 0 }, { scale: 1, opacity: 1, duration: 0.45, ease: "power2.out" }, 2.0);
      window.__timelines["main"] = tl;
      tl.seek(0);
    </script>
  </body>
</html>
