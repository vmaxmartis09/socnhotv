{"nodeId": "n_render", "nodeType": "hyperframes_render", "paramsSig": "5111ee5ceda9a4afe8d7755d4bf31982c1d396066cc4239562e3e0a79cda6ca4", "mock": true, "savedAt": "2026-11-07T01:53:27Z", "outputs": {"captions": {"$artifact": {"id": "art_7ca6719a062d", "kind": "text", "uri": "assets/7ca6719a062debff32d1930a6bf4d0076ae584b60a88465eafd5ff51f4ce9070.srt", "mime": "application/x-subrip", "size": 4848, "hash": "sha256:7ca6719a062debff32d1930a6bf4d0076ae584b60a88465eafd5ff51f4ce9070", "meta": {"width": null, "height": null, "duration": null, "fps": null, "aspect": null}, "provenance": {"nodeId": "n_render", "runId": "run_1794016061_ac215a", "provider": "local", "model": "dialogue-timeline", "params": {"lines": 30}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-07T01:47:43Z"}}}, "timeline": [{"lineId": "S01-1", "order": 0, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Chào các bạn nhỏ! Sáng nay ở nhà cây, Bi đang xếp một tòa tháp gỗ năm tầng thật cao nè!", "audio": {"$artifact": {"id": "art_4c47d6cfe14e", "kind": "audio", "uri": "assets/4c47d6cfe14e4018ed3ab686e7e26ac75bf710362e5ad57fe29129a9fc4b790a.mp3", "mime": "audio/mp3", "size": 156777, "hash": "sha256:4c47d6cfe14e4018ed3ab686e7e26ac75bf710362e5ad57fe29129a9fc4b790a", "meta": {"width": null, "height": null, "duration": 6.472, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Chào các bạn nhỏ! Sáng nay ở nhà cây, Bi đang xếp một tòa tháp gỗ năm tầng thật cao nè!", "voiceId": "soc-nho", "tempo": 1.1, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:19:11Z"}}}, "sceneIndex": 0, "audioStartSec": 0.3, "audioEndSec": 6.772}, {"lineId": "S02-2", "order": 1, "characterId": "de_mun", "speaker": "Dê Mun", "text": "Anh Bi ơi! Mun mang quả bóng vải sang chơi với anh Bi nè!", "audio": {"$artifact": {"id": "art_d957a4aa3b27", "kind": "audio", "uri": "assets/d957a4aa3b279a181fa702813e57e113e3b7db17573dca03e45a4f4e2ef2af67.mp3", "mime": "audio/mp3", "size": 124176, "hash": "sha256:d957a4aa3b279a181fa702813e57e113e3b7db17573dca03e45a4f4e2ef2af67", "meta": {"width": null, "height": null, "duration": 5.1, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Anh Bi ơi! Mun mang quả bóng vải sang chơi với anh Bi nè!", "voiceId": "vn-be-04", "tempo": 1.0, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:52:54Z"}}}, "sceneIndex": 1, "audioStartSec": 20.3, "audioEndSec": 25.4}, {"lineId": "S03-3", "order": 2, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Ủa, tại sao lúc nãy bụng Bi lại nóng ran như có ngọn núi lửa thế nhỉ? Bạn nhỏ cùng xem chuyện gì đã xảy ra nhé!", "audio": {"$artifact": {"id": "art_8c9a6d8f75dd", "kind": "audio", "uri": "assets/8c9a6d8f75dd38e5f8b38f0f03adfa859eda7d4b542fc470e2fa902cf9e4779a.mp3", "mime": "audio/mp3", "size": 183736, "hash": "sha256:8c9a6d8f75dd38e5f8b38f0f03adfa859eda7d4b542fc470e2fa902cf9e4779a", "meta": {"width": null, "height": null, "duration": 7.599, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Ủa, tại sao lúc nãy bụng Bi lại nóng ran như có ngọn núi lửa thế nhỉ? Bạn nhỏ cùng xem chuyện gì đã xảy ra nhé!", "voiceId": "soc-nho", "tempo": 1.1, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:19:50Z"}}}, "sceneIndex": 2, "audioStartSec": 40.3, "audioEndSec": 47.899}, {"lineId": "S04-4", "order": 3, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Mun ngồi bên cạnh xem anh Bi xếp tiếp tầng ba màu vàng và tầng bốn màu xanh lá nhé!", "audio": {"$artifact": {"id": "art_16db7370feee", "kind": "audio", "uri": "assets/16db7370feee179b0b8172be846fa8902f70ab30f36308469ee307981775fb95.mp3", "mime": "audio/mp3", "size": 109757, "hash": "sha256:16db7370feee179b0b8172be846fa8902f70ab30f36308469ee307981775fb95", "meta": {"width": null, "height": null, "duration": 4.519, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Mun ngồi bên cạnh xem anh Bi xếp tiếp tầng ba màu vàng và tầng bốn màu xanh lá nhé!", "voiceId": "soc-nho", "tempo": 1.1, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:19:43Z"}}}, "sceneIndex": 3, "audioStartSec": 60.3, "audioEndSec": 64.819}, {"lineId": "S05-5", "order": 4, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Tada! Còn mảnh ghép ngôi sao vàng cuối cùng này, anh Bi đặt lên đỉnh tầng năm nha!", "audio": {"$artifact": {"id": "art_0f26cb5dc184", "kind": "audio", "uri": "assets/0f26cb5dc18403dcdaef5c412483e45e86a363480c925f89a27df46f21836219.mp3", "mime": "audio/mp3", "size": 140477, "hash": "sha256:0f26cb5dc18403dcdaef5c412483e45e86a363480c925f89a27df46f21836219", "meta": {"width": null, "height": null, "duration": 5.791, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Tada! Còn mảnh ghép ngôi sao vàng cuối cùng này, anh Bi đặt lên đỉnh tầng năm nha!", "voiceId": "soc-nho", "tempo": 1.1, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:20:26Z"}}}, "sceneIndex": 4, "audioStartSec": 80.3, "audioEndSec": 86.091}, {"lineId": "S06-6", "order": 5, "characterId": "de_mun", "speaker": "Dê Mun", "text": "Oa, ngôi sao đẹp thích nhắm! Cho Mun lại gần xem ngôi sao với anh Bi ơi!", "audio": {"$artifact": {"id": "art_09b21d628683", "kind": "audio", "uri": "assets/09b21d62868324ae3eebf9fb7f9350ea4e28535c382aa5b8b030b4610779c9b6.mp3", "mime": "audio/mp3", "size": 132954, "hash": "sha256:09b21d62868324ae3eebf9fb7f9350ea4e28535c382aa5b8b030b4610779c9b6", "meta": {"width": null, "height": null, "duration": 5.461, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Oa, ngôi sao đẹp thích nhắm! Cho Mun lại gần xem ngôi sao với anh Bi ơi!", "voiceId": "vn-be-04", "tempo": 1.0, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:52:54Z"}}}, "sceneIndex": 5, "audioStartSec": 100.3, "audioEndSec": 105.761}, {"lineId": "S07-7", "order": 6, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Ấy khoan đã Mun ơi! Coi chừng vấp mép thảm… Ôi thôi, tháp gỗ của Bi!", "audio": {"$artifact": {"id": "art_8c92cdde45bf", "kind": "audio", "uri": "assets/8c92cdde45bf601966ca3757698bdefa22173e8f49ec8d4b3b8704bd11b295fd.mp3", "mime": "audio/mp3", "size": 142358, "hash": "sha256:8c92cdde45bf601966ca3757698bdefa22173e8f49ec8d4b3b8704bd11b295fd", "meta": {"width": null, "height": null, "duration": 5.872, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Ấy khoan đã Mun ơi! Coi chừng vấp mép thảm… Ôi thôi, tháp gỗ của Bi!", "voiceId": "soc-nho", "tempo": 1.1, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:21:23Z"}}}, "sceneIndex": 6, "audioStartSec": 120.3, "audioEndSec": 126.172}, {"lineId": "S08-8", "order": 7, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Phù… phù… Bao nhiêu công sức Bi xếp từ sáng tới giờ, đổ tan tành hết cả rồi!", "audio": {"$artifact": {"id": "art_602db1c3d39a", "kind": "audio", "uri": "assets/602db1c3d39a69c21fa300d69e6cf12d8a7a11bfe5ab12bfc17b01773cf4a5ce.mp3", "mime": "audio/mp3", "size": 146119, "hash": "sha256:602db1c3d39a69c21fa300d69e6cf12d8a7a11bfe5ab12bfc17b01773cf4a5ce", "meta": {"width": null, "height": null, "duration": 6.027, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Phù… phù… Bao nhiêu công sức Bi xếp từ sáng tới giờ, đổ tan tành hết cả rồi!", "voiceId": "soc-nho", "tempo": 1.1, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:21:27Z"}}}, "sceneIndex": 7, "audioStartSec": 140.3, "audioEndSec": 146.327}, {"lineId": "S09-9", "order": 8, "characterId": "de_mun", "speaker": "Dê Mun", "text": "Anh Bi ơi… Mun không cố ý đâu… Mun nhặt ngôi sao trả cho anh Bi nè…", "audio": {"$artifact": {"id": "art_24fc088ea55a", "kind": "audio", "uri": "assets/24fc088ea55a578aaccecbbb6c035cccdb6f275ced64f47f2dad703469974349.mp3", "mime": "audio/mp3", "size": 157404, "hash": "sha256:24fc088ea55a578aaccecbbb6c035cccdb6f275ced64f47f2dad703469974349", "meta": {"width": null, "height": null, "duration": 6.48, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Anh Bi ơi… Mun không cố ý đâu… Mun nhặt ngôi sao trả cho anh Bi nè…", "voiceId": "vn-be-04", "tempo": 1.0, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:53:37Z"}}}, "sceneIndex": 8, "audioStartSec": 160.3, "audioEndSec": 166.78}, {"lineId": "S10-10", "order": 9, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Bi không cần đâu! Tại Mun chạy ẩu làm hỏng tháp của Bi đấy! Hừ!", "audio": {"$artifact": {"id": "art_b18a6ea667d2", "kind": "audio", "uri": "assets/b18a6ea667d2eb78bcd3ff3f6632ad628cacf89843f552b11cf39017a5a50af4.mp3", "mime": "audio/mp3", "size": 134834, "hash": "sha256:b18a6ea667d2eb78bcd3ff3f6632ad628cacf89843f552b11cf39017a5a50af4", "meta": {"width": null, "height": null, "duration": 5.558, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Bi không cần đâu! Tại Mun chạy ẩu làm hỏng tháp của Bi đấy! Hừ!", "voiceId": "soc-nho", "tempo": 1.1, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:22:19Z"}}}, "sceneIndex": 9, "audioStartSec": 180.3, "audioEndSec": 185.858}, {"lineId": "S11-11", "order": 10, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Ơ… Mun khóc mất rồi… Sao lúc nãy bụng Bi nóng quá làm Bi lỡ quát em thế nhỉ?", "audio": {"$artifact": {"id": "art_fba770d4e55c", "kind": "audio", "uri": "assets/fba770d4e55c1b09dd6279c7a5f117f7e5c56c6c00471653fbaf9a22f320dd37.mp3", "mime": "audio/mp3", "size": 145492, "hash": "sha256:fba770d4e55c1b09dd6279c7a5f117f7e5c56c6c00471653fbaf9a22f320dd37", "meta": {"width": null, "height": null, "duration": 5.999, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Ơ… Mun khóc mất rồi… Sao lúc nãy bụng Bi nóng quá làm Bi lỡ quát em thế nhỉ?", "voiceId": "soc-nho", "tempo": 1.1, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:23:02Z"}}}, "sceneIndex": 10, "audioStartSec": 200.3, "audioEndSec": 206.299}, {"lineId": "S12-12", "order": 11, "characterId": "me_soc", "speaker": "Mẹ Sóc", "text": "Mẹ luôn ở đây nghe Bi và Mun nói mà! Có chuyện gì làm hai con buồn thế?", "audio": {"$artifact": {"id": "art_d11df766aeb5", "kind": "audio", "uri": "assets/d11df766aeb58a4ca727cefaf87835ee03ae8c597da3d00f2804614da1d0dfe6.mp3", "mime": "audio/mp3", "size": 116026, "hash": "sha256:d11df766aeb58a4ca727cefaf87835ee03ae8c597da3d00f2804614da1d0dfe6", "meta": {"width": null, "height": null, "duration": 4.76, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Mẹ luôn ở đây nghe Bi và Mun nói mà! Có chuyện gì làm hai con buồn thế?", "voiceId": "vn-nam-nu-01", "tempo": 1.0, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:22:58Z"}}}, "sceneIndex": 11, "audioStartSec": 220.3, "audioEndSec": 225.06}, {"lineId": "S13-13", "order": 12, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Mẹ ơi… Mun làm đổ tháp gỗ của con, tự nhiên bụng con nóng ran lên nên con lỡ mắng em Mun ạ…", "audio": {"$artifact": {"id": "art_67e3aaa88a08", "kind": "audio", "uri": "assets/67e3aaa88a087f734aa9c9b02042b2f9b11d2779e3639c1acd2488d8aa13811e.mp3", "mime": "audio/mp3", "size": 153016, "hash": "sha256:67e3aaa88a087f734aa9c9b02042b2f9b11d2779e3639c1acd2488d8aa13811e", "meta": {"width": null, "height": null, "duration": 6.299, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Mẹ ơi… Mun làm đổ tháp gỗ của con, tự nhiên bụng con nóng ran lên nên con lỡ mắng em Mun ạ…", "voiceId": "soc-nho", "tempo": 1.1, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:23:42Z"}}}, "sceneIndex": 12, "audioStartSec": 240.3, "audioEndSec": 246.599}, {"lineId": "S14-14", "order": 13, "characterId": "me_soc", "speaker": "Mẹ Sóc", "text": "À, khi đồ chơi bị đổ, trong bụng Bi xuất hiện một 'ngọn núi lửa giận dữ nhỏ' làm mặt nóng và tim đập nhanh đấy con ạ!", "audio": {"$artifact": {"id": "art_924f46ace32d", "kind": "audio", "uri": "assets/924f46ace32d01ca2cbbf18d4f1f8a7bf0b084c02a72f38cc9d3ea602a629445.mp3", "mime": "audio/mp3", "size": 187497, "hash": "sha256:924f46ace32d01ca2cbbf18d4f1f8a7bf0b084c02a72f38cc9d3ea602a629445", "meta": {"width": null, "height": null, "duration": 7.74, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "À, khi đồ chơi bị đổ, trong bụng Bi xuất hiện một 'ngọn núi lửa giận dữ nhỏ' làm mặt nóng và tim đập nhanh đấy con ạ!", "voiceId": "vn-nam-nu-01", "tempo": 1.0, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:23:37Z"}}}, "sceneIndex": 13, "audioStartSec": 260.3, "audioEndSec": 268.04}, {"lineId": "S15-15", "order": 14, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Thế làm sao để dập tắt ngọn núi lửa nóng trong bụng hả mẹ? Bạn nhỏ ơi, cùng nghe mẹ dạy bí quyết nhé!", "audio": {"$artifact": {"id": "art_254d8d93a848", "kind": "audio", "uri": "assets/254d8d93a848378e86ebfd79ca4697e08c2eada28e174ea341fd1d65d7d7f7dc.mp3", "mime": "audio/mp3", "size": 154896, "hash": "sha256:254d8d93a848378e86ebfd79ca4697e08c2eada28e174ea341fd1d65d7d7f7dc", "meta": {"width": null, "height": null, "duration": 6.391, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Thế làm sao để dập tắt ngọn núi lửa nóng trong bụng hả mẹ? Bạn nhỏ ơi, cùng nghe mẹ dạy bí quyết nhé!", "voiceId": "soc-nho", "tempo": 1.1, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:24:23Z"}}}, "sceneIndex": 14, "audioStartSec": 280.3, "audioEndSec": 286.691}, {"lineId": "S16-16", "order": 15, "characterId": "me_soc", "speaker": "Mẹ Sóc", "text": "Bí quyết của mẹ là 'Thở năm ngón tay'! Con xòe bàn tay trái ra, hít vào thơm như ngửi hoa, thở ra êm như thổi chong chóng nhé!", "audio": {"$artifact": {"id": "art_48813362e515", "kind": "audio", "uri": "assets/48813362e515db4c3c898880d258421c60b7de7008b8faa286980ce3c084be50.mp3", "mime": "audio/mp3", "size": 210067, "hash": "sha256:48813362e515db4c3c898880d258421c60b7de7008b8faa286980ce3c084be50", "meta": {"width": null, "height": null, "duration": 8.68, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Bí quyết của mẹ là 'Thở năm ngón tay'! Con xòe bàn tay trái ra, hít vào thơm như ngửi hoa, thở ra êm như thổi chong chóng nhé!", "voiceId": "vn-nam-nu-01", "tempo": 1.0, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:24:26Z"}}}, "sceneIndex": 15, "audioStartSec": 300.3, "audioEndSec": 308.98}, {"lineId": "S17-17", "order": 16, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Ngón hai, ngón ba, ngón bốn, ngón năm! Hít vào thơm hoa cúc… Thổi ra chong chóng quay tít! Bụng Bi mát dịu lại thật rồi mẹ ơi!", "audio": {"$artifact": {"id": "art_a3369ed0f3df", "kind": "audio", "uri": "assets/a3369ed0f3df9ed424c8c3cbc26bf7a1fd6de624ec810f466b95a345e9f98f1e.mp3", "mime": "audio/mp3", "size": 218844, "hash": "sha256:a3369ed0f3df9ed424c8c3cbc26bf7a1fd6de624ec810f466b95a345e9f98f1e", "meta": {"width": null, "height": null, "duration": 9.044, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Ngón hai, ngón ba, ngón bốn, ngón năm! Hít vào thơm hoa cúc… Thổi ra chong chóng quay tít! Bụng Bi mát dịu lại thật rồi mẹ ơi!", "voiceId": "soc-nho", "tempo": 1.1, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:25:35Z"}}}, "sceneIndex": 16, "audioStartSec": 320.3, "audioEndSec": 329.344}, {"lineId": "S18-18", "order": 17, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Mình nhớ câu thần chú rồi: 'Xòe tay hít sâu, núi lửa nguội mau!' Bạn nhỏ đọc to cùng Bi và Mun nào!", "audio": {"$artifact": {"id": "art_1547539d3304", "kind": "audio", "uri": "assets/1547539d33049cd9147247441ae284b2bf94a48be88f6cb466e2aee670d0cd31.mp3", "mime": "audio/mp3", "size": 153016, "hash": "sha256:1547539d33049cd9147247441ae284b2bf94a48be88f6cb466e2aee670d0cd31", "meta": {"width": null, "height": null, "duration": 6.317, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Mình nhớ câu thần chú rồi: 'Xòe tay hít sâu, núi lửa nguội mau!' Bạn nhỏ đọc to cùng Bi và Mun nào!", "voiceId": "soc-nho", "tempo": 1.1, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:25:02Z"}}}, "sceneIndex": 17, "audioStartSec": 340.3, "audioEndSec": 346.617}, {"lineId": "S19-19", "order": 18, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "🎵 Khi bụng em nóng ran, muốn hét lên thật to. Dừng lại ngay một chút, xòe bàn tay nhỏ ra! 🎵", "audio": {"$artifact": {"id": "art_b8b0b11d0e27", "kind": "audio", "uri": "assets/b8b0b11d0e27a002dcd16150c3a5aad2a04840e721b80f5667162e53f4bfff10.mp3", "mime": "audio/mp3", "size": 164928, "hash": "sha256:b8b0b11d0e27a002dcd16150c3a5aad2a04840e721b80f5667162e53f4bfff10", "meta": {"width": null, "height": null, "duration": 6.8, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "🎵 Khi bụng em nóng ran, muốn hét lên thật to. Dừng lại ngay một chút, xòe bàn tay nhỏ ra! 🎵", "voiceId": "soc-nho", "tempo": 1.1, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:25:58Z"}}}, "sceneIndex": 18, "audioStartSec": 360.3, "audioEndSec": 367.1}, {"lineId": "S20-20", "order": 19, "characterId": "de_mun", "speaker": "Dê Mun", "text": "🎵 Hít vào ngửi hoa thơm, thở ra chong chóng quay! 'Xòe tay hít sâu, núi lửa nguội mau!' 🎵", "audio": {"$artifact": {"id": "art_7d5e024d8a40", "kind": "audio", "uri": "assets/7d5e024d8a40d1ceda0ff3ed5e10bf93473fa1bfdb11e6937c5d7a2e403a7781.mp3", "mime": "audio/mp3", "size": 155523, "hash": "sha256:7d5e024d8a40d1ceda0ff3ed5e10bf93473fa1bfdb11e6937c5d7a2e403a7781", "meta": {"width": null, "height": null, "duration": 6.41, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "🎵 Hít vào ngửi hoa thơm, thở ra chong chóng quay! 'Xòe tay hít sâu, núi lửa nguội mau!' 🎵", "voiceId": "vn-be-04", "tempo": 1.0, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:53:32Z"}}}, "sceneIndex": 19, "audioStartSec": 380.3, "audioEndSec": 386.71}, {"lineId": "S21-21", "order": 20, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Đố bạn nhỏ nhé: Khi đang giận, chúng mình nên quát to hay nên xòe bàn tay năm ngón hít thở sâu nào? … Đúng rồi, xòe tay hít thở sâu nhé!", "audio": {"$artifact": {"id": "art_97fb0489e8ca", "kind": "audio", "uri": "assets/97fb0489e8cacf743480157f38d54aaa0434caeeee239a7d270af7421f2d7ad2.mp3", "mime": "audio/mp3", "size": 223233, "hash": "sha256:97fb0489e8cacf743480157f38d54aaa0434caeeee239a7d270af7421f2d7ad2", "meta": {"width": null, "height": null, "duration": 9.237, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Đố bạn nhỏ nhé: Khi đang giận, chúng mình nên quát to hay nên xòe bàn tay năm ngón hít thở sâu nào? … Đúng rồi, xòe tay hít thở sâu nhé!", "voiceId": "soc-nho", "tempo": 1.1, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:26:56Z"}}}, "sceneIndex": 20, "audioStartSec": 400.3, "audioEndSec": 409.537}, {"lineId": "S22-22", "order": 21, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Mun ơi, anh Bi xin lỗi vì lúc nãy đã quát to làm Mun sợ nhé! Anh em mình làm hòa nha!", "audio": {"$artifact": {"id": "art_6996a2a0c25b", "kind": "audio", "uri": "assets/6996a2a0c25b0b3509de3bb248aec6ea71f62b2b107e4ea790b28f296713aa5a.mp3", "mime": "audio/mp3", "size": 145492, "hash": "sha256:6996a2a0c25b0b3509de3bb248aec6ea71f62b2b107e4ea790b28f296713aa5a", "meta": {"width": null, "height": null, "duration": 5.999, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Mun ơi, anh Bi xin lỗi vì lúc nãy đã quát to làm Mun sợ nhé! Anh em mình làm hòa nha!", "voiceId": "soc-nho", "tempo": 1.1, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:26:54Z"}}}, "sceneIndex": 21, "audioStartSec": 420.3, "audioEndSec": 426.299}, {"lineId": "S23-23", "order": 22, "characterId": "de_mun", "speaker": "Dê Mun", "text": "Dạ, Mun cũng xin lỗi anh Bi! Bây giờ Mun phụ anh Bi xếp lại tòa tháp cao hơn nữa nhé!", "audio": {"$artifact": {"id": "art_608c7d9b9433", "kind": "audio", "uri": "assets/608c7d9b9433fed7ac248ba11cdbce3e2603d2e9d9348aff384a3d728f47d3c0.mp3", "mime": "audio/mp3", "size": 152389, "hash": "sha256:608c7d9b9433fed7ac248ba11cdbce3e2603d2e9d9348aff384a3d728f47d3c0", "meta": {"width": null, "height": null, "duration": 6.27, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Dạ, Mun cũng xin lỗi anh Bi! Bây giờ Mun phụ anh Bi xếp lại tòa tháp cao hơn nữa nhé!", "voiceId": "vn-be-04", "tempo": 1.0, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:54:05Z"}}}, "sceneIndex": 22, "audioStartSec": 440.3, "audioEndSec": 446.57}, {"lineId": "S24-24", "order": 23, "characterId": "me_soc", "speaker": "Mẹ Sóc", "text": "Hoan hô Bi và Mun! Khi bình tĩnh và biết yêu thương nhau, tòa tháp của hai con còn đẹp hơn cả lúc đầu đấy!", "audio": {"$artifact": {"id": "art_6519d55bc349", "kind": "audio", "uri": "assets/6519d55bc349c981054684dad999917985d0dfb7edc9fb75906b5fe4f80ebfed.mp3", "mime": "audio/mp3", "size": 186870, "hash": "sha256:6519d55bc349c981054684dad999917985d0dfb7edc9fb75906b5fe4f80ebfed", "meta": {"width": null, "height": null, "duration": 7.71, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Hoan hô Bi và Mun! Khi bình tĩnh và biết yêu thương nhau, tòa tháp của hai con còn đẹp hơn cả lúc đầu đấy!", "voiceId": "vn-nam-nu-01", "tempo": 1.0, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:27:36Z"}}}, "sceneIndex": 23, "audioStartSec": 460.3, "audioEndSec": 468.01}, {"lineId": "S25-25", "order": 24, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Cầm chong chóng ra ban công đón gió mát thôi Mun ơi! Nhìn chong chóng của hai anh em mình quay đẹp chưa kìa!", "audio": {"$artifact": {"id": "art_bbaf0d4032ee", "kind": "audio", "uri": "assets/bbaf0d4032ee70b72c21705e82dcbfef7383eecbb8c1c8fe538bcd1c82347c67.mp3", "mime": "audio/mp3", "size": 154896, "hash": "sha256:bbaf0d4032ee70b72c21705e82dcbfef7383eecbb8c1c8fe538bcd1c82347c67", "meta": {"width": null, "height": null, "duration": 6.381, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Cầm chong chóng ra ban công đón gió mát thôi Mun ơi! Nhìn chong chóng của hai anh em mình quay đẹp chưa kìa!", "voiceId": "soc-nho", "tempo": 1.1, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:28:18Z"}}}, "sceneIndex": 24, "audioStartSec": 480.3, "audioEndSec": 486.681}, {"lineId": "S26-26", "order": 25, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Bạn nhỏ nhớ nhé, mỗi khi thấy bụng nóng ran muốn giận dỗi, hãy đọc ngay: 'Xòe tay hít sâu, núi lửa nguội mau!'", "audio": {"$artifact": {"id": "art_7d7c777700fd", "kind": "audio", "uri": "assets/7d7c777700fdc74bcd0411e8364bdb6c110fd847cc1a9f9bf13d9c31ef913050.mp3", "mime": "audio/mp3", "size": 171824, "hash": "sha256:7d7c777700fdc74bcd0411e8364bdb6c110fd847cc1a9f9bf13d9c31ef913050", "meta": {"width": null, "height": null, "duration": 7.09, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Bạn nhỏ nhớ nhé, mỗi khi thấy bụng nóng ran muốn giận dỗi, hãy đọc ngay: 'Xòe tay hít sâu, núi lửa nguội mau!'", "voiceId": "soc-nho", "tempo": 1.1, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:28:10Z"}}}, "sceneIndex": 25, "audioStartSec": 500.3, "audioEndSec": 507.39}, {"lineId": "S27-27", "order": 26, "characterId": "de_mun", "speaker": "Dê Mun", "text": "Mun cũng thuộc bài thở năm ngón tay của Mẹ Sóc dạy rồi! Lần sau Mun sẽ đi đứng cẩn thận hơn ạ!", "audio": {"$artifact": {"id": "art_6785ebd55e1f", "kind": "audio", "uri": "assets/6785ebd55e1f7bf9a28d5e38a268651e58d50508bf68a06cf1834170a831a26d.mp3", "mime": "audio/mp3", "size": 168062, "hash": "sha256:6785ebd55e1f7bf9a28d5e38a268651e58d50508bf68a06cf1834170a831a26d", "meta": {"width": null, "height": null, "duration": 6.94, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Mun cũng thuộc bài thở năm ngón tay của Mẹ Sóc dạy rồi! Lần sau Mun sẽ đi đứng cẩn thận hơn ạ!", "voiceId": "vn-be-04", "tempo": 1.0, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:54:09Z"}}}, "sceneIndex": 26, "audioStartSec": 520.3, "audioEndSec": 527.24}, {"lineId": "S28-28", "order": 27, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "🎵 'Xòe tay hít sâu, núi lửa nguội mau!' — Trái tim êm dịu lại, mình nói lời yêu thương! 🎵", "audio": {"$artifact": {"id": "art_53472206d927", "kind": "audio", "uri": "assets/53472206d927aa8f7d9c73756212a7b97c936f196b841cec8537b072e5523d89.mp3", "mime": "audio/mp3", "size": 134208, "hash": "sha256:53472206d927aa8f7d9c73756212a7b97c936f196b841cec8537b072e5523d89", "meta": {"width": null, "height": null, "duration": 5.526, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "🎵 'Xòe tay hít sâu, núi lửa nguội mau!' — Trái tim êm dịu lại, mình nói lời yêu thương! 🎵", "voiceId": "soc-nho", "tempo": 1.1, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:28:58Z"}}}, "sceneIndex": 27, "audioStartSec": 540.3, "audioEndSec": 545.826}, {"lineId": "S29-29", "order": 28, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Cảm ơn bạn nhỏ đã đến nhà cây chơi với anh em Bi và Mun hôm nay nhé! Chúc bạn nhỏ luôn vui vẻ và ngoan ngoãn!", "audio": {"$artifact": {"id": "art_4c2147a2e8ca", "kind": "audio", "uri": "assets/4c2147a2e8ca3bdbc56c653b75982ffbda4988b66132f41ed874bae39749b5fe.mp3", "mime": "audio/mp3", "size": 181855, "hash": "sha256:4c2147a2e8ca3bdbc56c653b75982ffbda4988b66132f41ed874bae39749b5fe", "meta": {"width": null, "height": null, "duration": 7.517, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Cảm ơn bạn nhỏ đã đến nhà cây chơi với anh em Bi và Mun hôm nay nhé! Chúc bạn nhỏ luôn vui vẻ và ngoan ngoãn!", "voiceId": "soc-nho", "tempo": 1.1, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:29:30Z"}}}, "sceneIndex": 28, "audioStartSec": 560.3, "audioEndSec": 567.817}, {"lineId": "S30-30", "order": 29, "characterId": "me_soc", "speaker": "Mẹ Sóc", "text": "Hẹn gặp lại các bạn nhỏ ở tập tiếp theo của Sóc Nhỏ TV nhé! Tạm biệt các con!", "audio": {"$artifact": {"id": "art_3bdb53a4703f", "kind": "audio", "uri": "assets/3bdb53a4703fc5787979a5835ab124265cf0fbeaeb2a454ec3de315a09fe9540.mp3", "mime": "audio/mp3", "size": 133581, "hash": "sha256:3bdb53a4703fc5787979a5835ab124265cf0fbeaeb2a454ec3de315a09fe9540", "meta": {"width": null, "height": null, "duration": 5.49, "fps": null, "aspect": null}, "provenance": {"nodeId": "prebuild_voice", "runId": "prebuild_ep01-nui-lua-trong-bung-bi", "provider": "omnivoice", "model": "omnivoice", "params": {"text": "Hẹn gặp lại các bạn nhỏ ở tập tiếp theo của Sóc Nhỏ TV nhé! Tạm biệt các con!", "voiceId": "vn-nam-nu-01", "tempo": 1.0, "targetLufs": -14.0, "mastering": "deesser+presence3.2k+comp4:1+loudnorm-14LUFS"}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T10:29:34Z"}}}, "sceneIndex": 29, "audioStartSec": 580.3, "audioEndSec": 585.79}], "video": {"$artifact": {"id": "art_092e5f3f7cbd", "kind": "video", "uri": "assets/092e5f3f7cbd34af5d72acac7c12f3fa895ab22f696236b843a850c580cf1683.mp4", "mime": "video/mp4", "size": 274761535, "hash": "sha256:092e5f3f7cbd34af5d72acac7c12f3fa895ab22f696236b843a850c580cf1683", "meta": {"width": 1920, "height": 1080, "duration": 600.0, "fps": 30.0, "aspect": "16:9"}, "provenance": {"nodeId": "n_render", "runId": "run_1794016061_ac215a", "provider": "hyperframes", "model": "hyperframes-v0.9.12", "params": {"aspectRatio": "16:9", "width": 1920, "height": 1080, "fps": 30, "sceneCount": 30, "engine": "hyperframes"}, "inputHashes": ["sha256:c33de014c39ee7752d912950e818fade50466a4dc5d5c47c78e4182d977f2b79", "sha256:7ca6719a062debff32d1930a6bf4d0076ae584b60a88465eafd5ff51f4ce9070"], "costUsd": 0.0, "createdAt": "2026-11-07T01:53:26Z"}}}, "manifest": {"$artifact": {"id": "art_092e5f3f7cbd", "kind": "video", "uri": "assets/092e5f3f7cbd34af5d72acac7c12f3fa895ab22f696236b843a850c580cf1683.mp4", "mime": "video/mp4", "size": 274761535, "hash": "sha256:092e5f3f7cbd34af5d72acac7c12f3fa895ab22f696236b843a850c580cf1683", "meta": {"width": 1920, "height": 1080, "duration": 600.0, "fps": 30.0, "aspect": "16:9"}, "provenance": {"nodeId": "n_render", "runId": "run_1794016061_ac215a", "provider": "hyperframes", "model": "hyperframes-v0.9.12", "params": {"aspectRatio": "16:9", "width": 1920, "height": 1080, "fps": 30, "sceneCount"