{"nodeId": "n_char_bi", "capability": "speak", "key": "6cc60437b3875e1c88a0f67c0ab892afe8c333545a659a505e28bc857e23518e", "costUsd": 0.0, "savedAt": "2026-11-06T04:57:28Z", "outputs": {"voice": [{"lineId": "S01-1", "order": 0, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Chào các bạn nhỏ! Sáng nay ở nhà cây, Bi đang xếp một tòa tháp gỗ năm tầng thật cao nè!", "audio": {"$artifact": {"id": "art_609834d8603b", "kind": "audio", "uri": "assets/609834d8603b441f3428ca934cddc9c2ffac6c8c36a50310747b9ded08f929aa.wav", "mime": "audio/wav", "size": 280520, "hash": "sha256:609834d8603b441f3428ca934cddc9c2ffac6c8c36a50310747b9ded08f929aa", "meta": {"width": null, "height": null, "duration": 6.36, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Chào các bạn nhỏ! Sáng nay ở nhà cây, Bi đang xếp một tòa tháp gỗ năm tầng thật cao nè!", "voiceId": "soc-nho", "tempo": 1.1}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 6.36, "voiceId": "soc-nho", "shotId": "S01", "sceneIndex": 0, "startSec": 0, "endSec": 20}, {"lineId": "S03-3", "order": 2, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Ủa, tại sao lúc nãy bụng Bi lại nóng ran như có ngọn núi lửa thế nhỉ? Bạn nhỏ cùng xem chuyện gì đã xảy ra nhé!", "audio": {"$artifact": {"id": "art_60f9633027ef", "kind": "audio", "uri": "assets/60f9633027efcd3ea412c9ca60c766375228e3da35410a32fd5bb76fd76fa3cc.wav", "mime": "audio/wav", "size": 360782, "hash": "sha256:60f9633027efcd3ea412c9ca60c766375228e3da35410a32fd5bb76fd76fa3cc", "meta": {"width": null, "height": null, "duration": 8.18, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Ủa, tại sao lúc nãy bụng Bi lại nóng ran như có ngọn núi lửa thế nhỉ? Bạn nhỏ cùng xem chuyện gì đã xảy ra nhé!", "voiceId": "soc-nho", "tempo": 1.1}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 8.18, "voiceId": "soc-nho", "shotId": "S03", "sceneIndex": 2, "startSec": 40, "endSec": 60}, {"lineId": "S04-4", "order": 3, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Mun ngồi bên cạnh xem anh Bi xếp tiếp tầng ba màu vàng và tầng bốn màu xanh lá nhé!", "audio": {"$artifact": {"id": "art_dc64396295b9", "kind": "audio", "uri": "assets/dc64396295b99c1050a385e58442465eb29f8370b0673e8915e6b64fc9619d3a.wav", "mime": "audio/wav", "size": 267290, "hash": "sha256:dc64396295b99c1050a385e58442465eb29f8370b0673e8915e6b64fc9619d3a", "meta": {"width": null, "height": null, "duration": 6.06, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Mun ngồi bên cạnh xem anh Bi xếp tiếp tầng ba màu vàng và tầng bốn màu xanh lá nhé!", "voiceId": "soc-nho", "tempo": 1.1}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 6.06, "voiceId": "soc-nho", "shotId": "S04", "sceneIndex": 3, "startSec": 60, "endSec": 80}, {"lineId": "S05-5", "order": 4, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Tada! Còn mảnh ghép ngôi sao vàng cuối cùng này, anh Bi đặt lên đỉnh tầng năm nha!", "audio": {"$artifact": {"id": "art_961f2189dc83", "kind": "audio", "uri": "assets/961f2189dc8308854362c40dd2758b6381a0ab4937fed1d09017da06aeff54e3.wav", "mime": "audio/wav", "size": 240388, "hash": "sha256:961f2189dc8308854362c40dd2758b6381a0ab4937fed1d09017da06aeff54e3", "meta": {"width": null, "height": null, "duration": 5.45, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Tada! Còn mảnh ghép ngôi sao vàng cuối cùng này, anh Bi đặt lên đỉnh tầng năm nha!", "voiceId": "soc-nho", "tempo": 1.1}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 5.45, "voiceId": "soc-nho", "shotId": "S05", "sceneIndex": 4, "startSec": 80, "endSec": 100}, {"lineId": "S07-7", "order": 6, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Ấy khoan đã Mun ơi! Coi chừng vấp mép thảm… Ôi thôi, tháp gỗ của Bi!", "audio": {"$artifact": {"id": "art_04f9477eb15f", "kind": "audio", "uri": "assets/04f9477eb15f16eb06f7b70ce6e26bebe596edafb065780e2dc75025a4cad982.wav", "mime": "audio/wav", "size": 213928, "hash": "sha256:04f9477eb15f16eb06f7b70ce6e26bebe596edafb065780e2dc75025a4cad982", "meta": {"width": null, "height": null, "duration": 4.85, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Ấy khoan đã Mun ơi! Coi chừng vấp mép thảm… Ôi thôi, tháp gỗ của Bi!", "voiceId": "soc-nho", "tempo": 1.1}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 4.85, "voiceId": "soc-nho", "shotId": "S07", "sceneIndex": 6, "startSec": 120, "endSec": 140}, {"lineId": "S08-8", "order": 7, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Phù… phù… Bao nhiêu công sức Bi xếp từ sáng tới giờ, đổ tan tành hết cả rồi!", "audio": {"$artifact": {"id": "art_961f2189dc83", "kind": "audio", "uri": "assets/961f2189dc8308854362c40dd2758b6381a0ab4937fed1d09017da06aeff54e3.wav", "mime": "audio/wav", "size": 240388, "hash": "sha256:961f2189dc8308854362c40dd2758b6381a0ab4937fed1d09017da06aeff54e3", "meta": {"width": null, "height": null, "duration": 5.45, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Phù… phù… Bao nhiêu công sức Bi xếp từ sáng tới giờ, đổ tan tành hết cả rồi!", "voiceId": "soc-nho", "tempo": 1.1}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 5.45, "voiceId": "soc-nho", "shotId": "S08", "sceneIndex": 7, "startSec": 140, "endSec": 160}, {"lineId": "S10-10", "order": 9, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Bi không cần đâu! Tại Mun chạy ẩu làm hỏng tháp của Bi đấy! Hừ!", "audio": {"$artifact": {"id": "art_abbf7e43ef20", "kind": "audio", "uri": "assets/abbf7e43ef2066713e5675cb3823dcb8ade1e4f54487216bec9da5e50281dd33.wav", "mime": "audio/wav", "size": 200698, "hash": "sha256:abbf7e43ef2066713e5675cb3823dcb8ade1e4f54487216bec9da5e50281dd33", "meta": {"width": null, "height": null, "duration": 4.55, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Bi không cần đâu! Tại Mun chạy ẩu làm hỏng tháp của Bi đấy! Hừ!", "voiceId": "soc-nho", "tempo": 1.1}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 4.55, "voiceId": "soc-nho", "shotId": "S10", "sceneIndex": 9, "startSec": 180, "endSec": 200}, {"lineId": "S11-11", "order": 10, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Ơ… Mun khóc mất rồi… Sao lúc nãy bụng Bi nóng quá làm Bi lỡ quát em thế nhỉ?", "audio": {"$artifact": {"id": "art_64e91e77754a", "kind": "audio", "uri": "assets/64e91e77754a95d9731d76ed61f263343f1390e4281a323f356cab85fdfb6309.wav", "mime": "audio/wav", "size": 254060, "hash": "sha256:64e91e77754a95d9731d76ed61f263343f1390e4281a323f356cab85fdfb6309", "meta": {"width": null, "height": null, "duration": 5.76, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Ơ… Mun khóc mất rồi… Sao lúc nãy bụng Bi nóng quá làm Bi lỡ quát em thế nhỉ?", "voiceId": "soc-nho", "tempo": 1.1}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 5.76, "voiceId": "soc-nho", "shotId": "S11", "sceneIndex": 10, "startSec": 200, "endSec": 220}, {"lineId": "S13-13", "order": 12, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Mẹ ơi… Mun làm đổ tháp gỗ của con, tự nhiên bụng con nóng ran lên nên con lỡ mắng em Mun ạ…", "audio": {"$artifact": {"id": "art_4d26a1dcb5ce", "kind": "audio", "uri": "assets/4d26a1dcb5ce331f2d828d57076ed874e2438ad891a21b949bef480677f56ef1.wav", "mime": "audio/wav", "size": 307420, "hash": "sha256:4d26a1dcb5ce331f2d828d57076ed874e2438ad891a21b949bef480677f56ef1", "meta": {"width": null, "height": null, "duration": 6.97, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Mẹ ơi… Mun làm đổ tháp gỗ của con, tự nhiên bụng con nóng ran lên nên con lỡ mắng em Mun ạ…", "voiceId": "soc-nho", "tempo": 1.1}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 6.97, "voiceId": "soc-nho", "shotId": "S13", "sceneIndex": 12, "startSec": 240, "endSec": 260}, {"lineId": "S15-15", "order": 14, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Thế làm sao để dập tắt ngọn núi lửa nóng trong bụng hả mẹ? Bạn nhỏ ơi, cùng nghe mẹ dạy bí quyết nhé!", "audio": {"$artifact": {"id": "art_49fc375231ca", "kind": "audio", "uri": "assets/49fc375231cacaea18776a4bf5a6f6f362ab554535c450fc04e38c927b2cfb02.wav", "mime": "audio/wav", "size": 320650, "hash": "sha256:49fc375231cacaea18776a4bf5a6f6f362ab554535c450fc04e38c927b2cfb02", "meta": {"width": null, "height": null, "duration": 7.27, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Thế làm sao để dập tắt ngọn núi lửa nóng trong bụng hả mẹ? Bạn nhỏ ơi, cùng nghe mẹ dạy bí quyết nhé!", "voiceId": "soc-nho", "tempo": 1.1}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 7.27, "voiceId": "soc-nho", "shotId": "S15", "sceneIndex": 14, "startSec": 280, "endSec": 300}, {"lineId": "S17-17", "order": 16, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Ngón hai, ngón ba, ngón bốn, ngón năm! Hít vào thơm hoa cúc… Thổi ra chong chóng quay tít! Bụng Bi mát dịu lại thật rồi mẹ ơi!", "audio": {"$artifact": {"id": "art_0c5ee9759a70", "kind": "audio", "uri": "assets/0c5ee9759a706a4623f8f518aef111b63223374ed77ec9b0c062aac2aacc5fe7.wav", "mime": "audio/wav", "size": 374012, "hash": "sha256:0c5ee9759a706a4623f8f518aef111b63223374ed77ec9b0c062aac2aacc5fe7", "meta": {"width": null, "height": null, "duration": 8.48, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Ngón hai, ngón ba, ngón bốn, ngón năm! Hít vào thơm hoa cúc… Thổi ra chong chóng quay tít! Bụng Bi mát dịu lại thật rồi mẹ ơi!", "voiceId": "soc-nho", "tempo": 1.1}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 8.48, "voiceId": "soc-nho", "shotId": "S17", "sceneIndex": 16, "startSec": 320, "endSec": 340}, {"lineId": "S18-18", "order": 17, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Mình nhớ câu thần chú rồi: 'Xòe tay hít sâu, núi lửa nguội mau!' Bạn nhỏ đọc to cùng Bi và Mun nào!", "audio": {"$artifact": {"id": "art_4d26a1dcb5ce", "kind": "audio", "uri": "assets/4d26a1dcb5ce331f2d828d57076ed874e2438ad891a21b949bef480677f56ef1.wav", "mime": "audio/wav", "size": 307420, "hash": "sha256:4d26a1dcb5ce331f2d828d57076ed874e2438ad891a21b949bef480677f56ef1", "meta": {"width": null, "height": null, "duration": 6.97, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Mình nhớ câu thần chú rồi: 'Xòe tay hít sâu, núi lửa nguội mau!' Bạn nhỏ đọc to cùng Bi và Mun nào!", "voiceId": "soc-nho", "tempo": 1.1}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 6.97, "voiceId": "soc-nho", "shotId": "S18", "sceneIndex": 17, "startSec": 340, "endSec": 360}, {"lineId": "S19-19", "order": 18, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "🎵 Khi bụng em nóng ran, muốn hét lên thật to. Dừng lại ngay một chút, xòe bàn tay nhỏ ra! 🎵", "audio": {"$artifact": {"id": "art_d5ddc8139e6d", "kind": "audio", "uri": "assets/d5ddc8139e6d9ddd430b007d39e11124f38846f6aa34fe37402e09b2b991dded.wav", "mime": "audio/wav", "size": 294190, "hash": "sha256:d5ddc8139e6d9ddd430b007d39e11124f38846f6aa34fe37402e09b2b991dded", "meta": {"width": null, "height": null, "duration": 6.67, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "🎵 Khi bụng em nóng ran, muốn hét lên thật to. Dừng lại ngay một chút, xòe bàn tay nhỏ ra! 🎵", "voiceId": "soc-nho", "tempo": 1.1}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 6.67, "voiceId": "soc-nho", "shotId": "S19", "sceneIndex": 18, "startSec": 360, "endSec": 380}, {"lineId": "S21-21", "order": 20, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Đố bạn nhỏ nhé: Khi đang giận, chúng mình nên quát to hay nên xòe bàn tay năm ngón hít thở sâu nào? … Đúng rồi, xòe tay hít thở sâu nhé!", "audio": {"$artifact": {"id": "art_4c1a501cb8bc", "kind": "audio", "uri": "assets/4c1a501cb8bc5e3c231d924efd9e70a610ee979b9c3ce41132770a8a049b2785.wav", "mime": "audio/wav", "size": 427812, "hash": "sha256:4c1a501cb8bc5e3c231d924efd9e70a610ee979b9c3ce41132770a8a049b2785", "meta": {"width": null, "height": null, "duration": 9.7, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Đố bạn nhỏ nhé: Khi đang giận, chúng mình nên quát to hay nên xòe bàn tay năm ngón hít thở sâu nào? … Đúng rồi, xòe tay hít thở sâu nhé!", "voiceId": "soc-nho", "tempo": 1.1}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 9.7, "voiceId": "soc-nho", "shotId": "S21", "sceneIndex": 20, "startSec": 400, "endSec": 420}, {"lineId": "S22-22", "order": 21, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Mun ơi, anh Bi xin lỗi vì lúc nãy đã quát to làm Mun sợ nhé! Anh em mình làm hòa nha!", "audio": {"$artifact": {"id": "art_d5ddc8139e6d", "kind": "audio", "uri": "assets/d5ddc8139e6d9ddd430b007d39e11124f38846f6aa34fe37402e09b2b991dded.wav", "mime": "audio/wav", "size": 294190, "hash": "sha256:d5ddc8139e6d9ddd430b007d39e11124f38846f6aa34fe37402e09b2b991dded", "meta": {"width": null, "height": null, "duration": 6.67, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Mun ơi, anh Bi xin lỗi vì lúc nãy đã quát to làm Mun sợ nhé! Anh em mình làm hòa nha!", "voiceId": "soc-nho", "tempo": 1.1}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 6.67, "voiceId": "soc-nho", "shotId": "S22", "sceneIndex": 21, "startSec": 420, "endSec": 440}, {"lineId": "S25-25", "order": 24, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Cầm chong chóng ra ban công đón gió mát thôi Mun ơi! Nhìn chong chóng của hai anh em mình quay đẹp chưa kìa!", "audio": {"$artifact": {"id": "art_49fc375231ca", "kind": "audio", "uri": "assets/49fc375231cacaea18776a4bf5a6f6f362ab554535c450fc04e38c927b2cfb02.wav", "mime": "audio/wav", "size": 320650, "hash": "sha256:49fc375231cacaea18776a4bf5a6f6f362ab554535c450fc04e38c927b2cfb02", "meta": {"width": null, "height": null, "duration": 7.27, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Cầm chong chóng ra ban công đón gió mát thôi Mun ơi! Nhìn chong chóng của hai anh em mình quay đẹp chưa kìa!", "voiceId": "soc-nho", "tempo": 1.1}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 7.27, "voiceId": "soc-nho", "shotId": "S25", "sceneIndex": 24, "startSec": 480, "endSec": 500}, {"lineId": "S26-26", "order": 25, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Bạn nhỏ nhớ nhé, mỗi khi thấy bụng nóng ran muốn giận dỗi, hãy đọc ngay: 'Xòe tay hít sâu, núi lửa nguội mau!'", "audio": {"$artifact": {"id": "art_49fc375231ca", "kind": "audio", "uri": "assets/49fc375231cacaea18776a4bf5a6f6f362ab554535c450fc04e38c927b2cfb02.wav", "mime": "audio/wav", "size": 320650, "hash": "sha256:49fc375231cacaea18776a4bf5a6f6f362ab554535c450fc04e38c927b2cfb02", "meta": {"width": null, "height": null, "duration": 7.27, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Bạn nhỏ nhớ nhé, mỗi khi thấy bụng nóng ran muốn giận dỗi, hãy đọc ngay: 'Xòe tay hít sâu, núi lửa nguội mau!'", "voiceId": "soc-nho", "tempo": 1.1}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 7.27, "voiceId": "soc-nho", "shotId": "S26", "sceneIndex": 25, "startSec": 500, "endSec": 520}, {"lineId": "S28-28", "order": 27, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "🎵 'Xòe tay hít sâu, núi lửa nguội mau!' — Trái tim êm dịu lại, mình nói lời yêu thương! 🎵", "audio": {"$artifact": {"id": "art_609834d8603b", "kind": "audio", "uri": "assets/609834d8603b441f3428ca934cddc9c2ffac6c8c36a50310747b9ded08f929aa.wav", "mime": "audio/wav", "size": 280520, "hash": "sha256:609834d8603b441f3428ca934cddc9c2ffac6c8c36a50310747b9ded08f929aa", "meta": {"width": null, "height": null, "duration": 6.36, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "🎵 'Xòe tay hít sâu, núi lửa nguội mau!' — Trái tim êm dịu lại, mình nói lời yêu thương! 🎵", "voiceId": "soc-nho", "tempo": 1.1}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 6.36, "voiceId": "soc-nho", "shotId": "S28", "sceneIndex": 27, "startSec": 540, "endSec": 560}, {"lineId": "S29-29", "order": 28, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Cảm ơn bạn nhỏ đã đến nhà cây chơi với anh em Bi và Mun hôm nay nhé! Chúc bạn nhỏ luôn vui vẻ và ngoan ngoãn!", "audio": {"$artifact": {"id": "art_60f9633027ef", "kind": "audio", "uri": "assets/60f9633027efcd3ea412c9ca60c766375228e3da35410a32fd5bb76fd76fa3cc.wav", "mime": "audio/wav", "size": 360782, "hash": "sha256:60f9633027efcd3ea412c9ca60c766375228e3da35410a32fd5bb76fd76fa3cc", "meta": {"width": null, "height": null, "duration": 8.18, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Cảm ơn bạn nhỏ đã đến nhà cây chơi với anh em Bi và Mun hôm nay nhé! Chúc bạn nhỏ luôn vui vẻ và ngoan ngoãn!", "voiceId": "soc-nho", "tempo": 1.1}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 8.18, "voiceId": "soc-nho", "shotId": "S29", "sceneIndex": 28, "startSec": 560, "endSec": 580}]}}