_1793955103_4fe503", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Chào các bạn nhỏ! Hôm nay ở Nhà của Bông & Mun trên sườn đồi, Dê Mun có một món đồ rất vui nè, các bạn nhìn xem là gì đây?", "voiceId": "vn-be-04", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T08:51:43Z"}}}, "durationSec": 10.33, "voiceId": "vn-be-04", "shotId": "S01", "sceneIndex": 0, "startSec": 0, "endSec": 20}, {"lineId": "S02-2", "order": 1, "characterId": "de_bong", "speaker": "Dê Bông", "text": "Oa, thích quá Dê Mun ơi! Hôm nay hai đứa mình sẽ cùng chơi và khám phá ở Nhà của Bông & Mun trên sườn đồi nhé!", "audio": {"$artifact": {"id": "art_f60dcddb714e", "kind": "audio", "uri": "assets/f60dcddb714e325603a2ac575fc7db6d29fceb56721863d9882c1f314633f00f.wav", "mime": "audio/wav", "size": 396944, "hash": "sha256:f60dcddb714e325603a2ac575fc7db6d29fceb56721863d9882c1f314633f00f", "meta": {"width": null, "height": null, "duration": 9.0, "fps": null, "aspect": null}, "provenance": {"nodeId": "c", "runId": "run_1793955103_4fe503", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Oa, thích quá Dê Mun ơi! Hôm nay hai đứa mình sẽ cùng chơi và khám phá ở Nhà của Bông & Mun trên sườn đồi nhé!", "voiceId": "vn-be-01", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T08:51:43Z"}}}, "durationSec": 9.0, "voiceId": "vn-be-01", "shotId": "S02", "sceneIndex": 1, "startSec": 20, "endSec": 40}, {"lineId": "S03-3", "order": 2, "characterId": "de_mun", "speaker": "Dê Mun", "text": "Bạn nhỏ ơi, hôm nay câu chuyện 'Mun sợ bóng tối' sẽ bắt đầu ngay bây giờ! Bạn nhỏ đã sẵn sàng cùng Dê Mun chưa nào?", "audio": {"$artifact": {"id": "art_f60dcddb714e", "kind": "audio", "uri": "assets/f60dcddb714e325603a2ac575fc7db6d29fceb56721863d9882c1f314633f00f.wav", "mime": "audio/wav", "size": 396944, "hash": "sha256:f60dcddb714e325603a2ac575fc7db6d29fceb56721863d9882c1f314633f00f", "meta": {"width": null, "height": null, "duration": 9.0, "fps": null, "aspect": null}, "provenance": {"nodeId": "c", "runId": "run_1793955103_4fe503", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Bạn nhỏ ơi, hôm nay câu chuyện 'Mun sợ bóng tối' sẽ bắt đầu ngay bây giờ! Bạn nhỏ đã sẵn sàng cùng Dê Mun chưa nào?", "voiceId": "vn-be-04", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T08:51:43Z"}}}, "durationSec": 9.0, "voiceId": "vn-be-04", "shotId": "S03", "sceneIndex": 2, "startSec": 40, "endSec": 60}, {"lineId": "S04-4", "order": 3, "characterId": "de_mun", "speaker": "Dê Mun", "text": "Mình làm từ từ từng bước một nhé! Sắp hoàn thành xong phần đầu tiên rồi đây!", "audio": {"$artifact": {"id": "art_56c77de9f2bd", "kind": "audio", "uri": "assets/56c77de9f2bdf23187ef92d40bc5d03012b10a98fda1e36787b26d1ff4fadaf1.wav", "mime": "audio/wav", "size": 250090, "hash": "sha256:56c77de9f2bdf23187ef92d40bc5d03012b10a98fda1e36787b26d1ff4fadaf1", "meta": {"width": null, "height": null, "duration": 5.67, "fps": null, "aspect": null}, "provenance": {"nodeId": "c", "runId": "run_1793955103_4fe503", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Mình làm từ từ từng bước một nhé! Sắp hoàn thành xong phần đầu tiên rồi đây!", "voiceId": "vn-be-04", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T08:51:43Z"}}}, "durationSec": 5.67, "voiceId": "vn-be-04", "shotId": "S04", "sceneIndex": 3, "startSec": 60, "endSec": 80}, {"lineId": "S05-5", "order": 4, "characterId": "de_mun", "speaker": "Dê Mun", "text": "Tada! Bạn nhỏ nhìn xem, Dê Mun đã xếp ngay ngắn và đẹp ơi là đẹp chưa nè!", "audio": {"$artifact": {"id": "art_653acb3a59a0", "kind": "audio", "uri": "assets/653acb3a59a078c3461f144575a5ad2402877be6e7ef72515401caf3372a5da9.wav", "mime": "audio/wav", "size": 264644, "hash": "sha256:653acb3a59a078c3461f144575a5ad2402877be6e7ef72515401caf3372a5da9", "meta": {"width": null, "height": null, "duration": 6.0, "fps": null, "aspect": null}, "provenan