e": 396944, "hash": "sha256:f60dcddb714e325603a2ac575fc7db6d29fceb56721863d9882c1f314633f00f", "meta": {"width": null, "height": null, "duration": 9.0, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793968037_2140cd", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Ủa, tại sao lúc nãy bụng Bi lại nóng ran như có ngọn núi lửa thế nhỉ? Bạn nhỏ cùng xem chuyện gì đã xảy ra nhé!", "voiceId": "soc-nho", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T12:27:17Z"}}}, "durationSec": 9.0, "voiceId": "soc-nho", "shotId": "S03", "sceneIndex": 2, "startSec": 40, "endSec": 60}, {"lineId": "S04-4", "order": 3, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Mun ngồi bên cạnh xem anh Bi xếp tiếp tầng ba màu vàng và tầng bốn màu xanh lá nhé!", "audio": {"$artifact": {"id": "art_d5ddc8139e6d", "kind": "audio", "uri": "assets/d5ddc8139e6d9ddd430b007d39e11124f38846f6aa34fe37402e09b2b991dded.wav", "mime": "audio/wav", "size": 294190, "hash": "sha256:d5ddc8139e6d9ddd430b007d39e11124f38846f6aa34fe37402e09b2b991dded", "meta": {"width": null, "height": null, "duration": 6.67, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793968037_2140cd", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Mun ngồi bên cạnh xem anh Bi xếp tiếp tầng ba màu vàng và tầng bốn màu xanh lá nhé!", "voiceId": "soc-nho", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T12:27:17Z"}}}, "durationSec": 6.67, "voiceId": "soc-nho", "shotId": "S04", "sceneIndex": 3, "startSec": 60, "endSec": 80}, {"lineId": "S05-5", "order": 4, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Tada! Còn mảnh ghép ngôi sao vàng cuối cùng này, anh Bi đặt lên đỉnh tầng năm nha!", "audio": {"$artifact": {"id": "art_653acb3a59a0", "kind": "audio", "uri": "assets/653acb3a59a078c3461f144575a5ad2402877be6e7ef72515401caf3372a5da9.wav", "mime": "audio/wav", "size": 264644, "hash": "sha256:653acb3a59a078c3461f144575a5ad2402877be6e7ef72515401caf3372a5da9", "meta": {"width": null, "height": null, "duration": 6.0, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793968037_2140cd", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Tada! Còn mảnh ghép ngôi sao vàng cuối cùng này, anh Bi đặt lên đỉnh tầng năm nha!", "voiceId": "soc-nho", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T12:27:17Z"}}}, "durationSec": 6.0, "voiceId": "soc-nho", "shotId": "S05", "sceneIndex": 4, "startSec": 80, "endSec": 100}, {"lineId": "S07-7", "order": 6, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Ấy khoan đã Mun ơi! Coi chừng vấp mép thảm… Ôi thôi, tháp gỗ của Bi!", "audio": {"$artifact": {"id": "art_213d4fe2164e", "kind": "audio", "uri": "assets/213d4fe2164e557117b8c3d2c3a58e9afa76e4a5e4f88491972d05264b4608c9.wav", "mime": "audio/wav", "size": 235096, "hash": "sha256:213d4fe2164e557117b8c3d2c3a58e9afa76e4a5e4f88491972d05264b4608c9", "meta": {"width": null, "height": null, "duration": 5.33, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793968037_2140cd", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Ấy khoan đã Mun ơi! Coi chừng vấp mép thảm… Ôi thôi, tháp gỗ của Bi!", "voiceId": "soc-nho", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T12:27:17Z"}}}, "durationSec": 5.33, "voiceId": "soc-nho", "shotId": "S07", "sceneIndex": 6, "startSec": 120, "endSec": 140}, {"lineId": "S08-8", "order": 7, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Phù… phù… Bao nhiêu công sức Bi xếp từ sáng tới giờ, đổ tan tành hết cả rồi!", "audio": {"$artifact": {"id": "art_653acb3a59a0", "kind": "audio", "uri": "assets/653acb3a59a078c3461f144575a5ad2402877be6e7ef72515401caf3372a5da9.wav", "mime": "audio/wav", "size": 264644, "hash": "sha256:653acb3a59a078c3461f144575a5ad2402877be6e7ef72515401caf3372a5da9", "meta": {"width": null, "height": null, "duration": 6.0, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793968037_2140cd", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Phù… phù… Bao nhiêu công sức Bi xếp từ sáng tới giờ, đổ tan tành hết cả rồi!", "voiceId": "soc-nho", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T12:27:17Z"}}}, "durationSec": 6.0, "voiceId": "soc-nho", "shotId": "S08", "sceneIndex": 7, "startSec": 140, "endSec": 160}, {"lineId": "S10-10", "order": 9, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Bi không cần đâu! Tại Mun chạy ẩu làm hỏng tháp của Bi đấy! Hừ!", "audio": {"$artifact": {"id": "art_d2ac3a234e33", "kind": "audio", "uri": "assets/d2ac3a234e3314659ef06a7421b34f7fa11aa19f5cce780cce8b028870cd71f8.wav", "mime": "audio/wav", "size": 220544, "hash": "sha256:d2ac3a234e3314659ef06a7421b34f7fa11aa19f5cce780cce8b028870cd71f8", "meta": {"width": null, "height": null, "duration": 5.0, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793968037_2140cd", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Bi không cần đâu! Tại Mun chạy ẩu làm hỏng tháp của Bi đấy! Hừ!", "voiceId": "soc-nho", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T12:27:17Z"}}}, "durationSec": 5.0, "voiceId": "soc-nho", "shotId": "S10", "sceneIndex": 9, "startSec": 180, "endSec": 200}, {"lineId": "S11-11", "order": 10, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Ơ… Mun khóc mất rồi… Sao lúc nãy bụng Bi nóng quá làm Bi lỡ quát em thế nhỉ?", "audio": {"$artifact": {"id": "art_c6e0559fb8c0", "kind": "audio", "uri": "assets/c6e0559fb8c055a70a18ce4a64f113e7e38236f35b2b66a34ed598e27a8858c0.wav", "mime": "audio/wav", "size": 279196, "hash": "sha256:c6e0559fb8c055a70a18ce4a64f113e7e38236f35b2b66a34ed598e27a8858c0", "meta": {"width": null, "height": null, "duration": 6.33, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793968037_2140cd", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Ơ… Mun khóc mất rồi… Sao lúc nãy bụng Bi nóng quá làm Bi lỡ quát em thế nhỉ?", "voiceId": "soc-nho", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T12:27:17Z"}}}, "durationSec": 6.33, "voiceId": "soc-nho", "shotId": "S11", "sceneIndex": 10, "startSec": 200, "endSec": 220}, {"lineId": "S13-13", "order": 12, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Mẹ ơi… Mun làm đổ tháp gỗ của con, tự nhiên bụng con nóng ran lên nên con lỡ mắng em Mun ạ…", "audio": {"$artifact": {"id": "art_b75b34076b1a", "kind": "audio", "uri": "assets/b75b34076b1a0d70177268fd2c10e6b90ac15757774428ace28e8e16e6d90794.wav", "mime": "audio/wav", "size": 338290, "hash": "sha256:b75b34076b1a0d70177268fd2c10e6b90ac15757774428ace28e8e16e6d90794", "meta": {"width": null, "height": null, "duration": 7.67, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793968037_2140cd", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Mẹ ơi… Mun làm đổ tháp gỗ của con, tự nhiên bụng con nóng ran lên nên con lỡ mắng em Mun ạ…", "voiceId": "soc-nho", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T12:27:17Z"}}}, "durationSec": 7.67, "voiceId": "soc-nho", "shotId": "S13", "sceneIndex": 12, "startSec": 240, "endSec": 260}, {"lineId": "S15-15", "order": 14, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Thế làm sao để dập tắt ngọn núi lửa nóng trong bụng hả mẹ? Bạn nhỏ ơi, cùng nghe mẹ dạy bí quyết nhé!", "audio": {"$artifact": {"id": "art_d632daecb4ab", "kind": "audio", "uri": "assets/d632daecb4ab19e0f93f179107f4bb4240d5b261217dd6fe33505d7b4fc6106f.wav", "mime": "audio/wav", "size": 352844, "hash": "sha256:d632daecb4ab19e0f93f179107f4bb4240d5b261217dd6fe33505d7b4fc6106f", "meta": {"width": null, "height": null, "duration": 8.0, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793968037_2140cd", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Thế làm sao để dập tắt ngọn núi lửa nóng trong bụng hả mẹ? Bạn nhỏ ơi, cùng nghe mẹ dạy bí quyết nhé!", "voiceId": "soc-nho", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T12:27:17Z"}}}, "durationSec": 8.0, "voiceId": "soc-nho", "shotId": "S15", "sceneIndex": 14, "startSec": 280, "endSec": 300}, {"lineId": "S17-17", "order": 16, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Ngón hai, ngón ba, ngón bốn, ngón năm! Hít vào thơm hoa cúc… Thổi ra chong chóng quay tít! Bụng Bi mát dịu lại thật rồi mẹ ơi!", "audio": {"$artifact": {"id": "art_51d6c160ad26", "kind": "audio", "uri": "assets/51d6c160ad2679d55cf5dc0b28f6c076e1fcd38115c079233bb1c44f3ee742f3.wav", "mime": "audio/wav", "size": 411496, "hash": "sha256:51d6c160ad2679d55cf5dc0b28f6c076e1fcd38115c079233bb1c44f3ee742f3", "meta": {"width": null, "height": null, "duration": 9.33, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793968037_2140cd", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Ngón hai, ngón ba, ngón bốn, ngón năm! Hít vào thơm hoa cúc… Thổi ra chong chóng quay tít! Bụng Bi mát dịu lại thật rồi mẹ ơi!", "voiceId": "soc-nho", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T12:27:17Z"}}}, "durationSec": 9.33, "voiceId": "soc-nho", "shotId": "S17", "sceneIndex": 16, "startSec": 320, "endSec": 340}, {"lineId": "S18-18", "order": 17, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Mình nhớ câu thần chú rồi: 'Xòe tay hít sâu, núi lửa nguội mau!' Bạn nhỏ đọc to cùng Bi và Mun nào!", "audio": {"$artifact": {"id": "art_b75b34076b1a", "kind": "audio", "uri": "assets/b75b34076b1a0d70177268fd2c10e6b90ac15757774428ace28e8e16e6d90794.wav", "mime": "audio/wav", "size": 338290, "hash": "sha256:b75b34076b1a0d70177268fd2c10e6b90ac15757774428ace28e8e16e6d90794", "meta": {"width": null, "height": null, "duration": 7.67, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793968037_2140cd", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Mình nhớ câu thần chú rồi: 'Xòe tay hít sâu, núi lửa nguội mau!' Bạn nhỏ đọc to cùng Bi và Mun nào!", "voiceId": "soc-nho", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T12:27:17Z"}}}, "durationSec": 7.67, "voiceId": "soc-nho", "shotId": "S18", "sceneIndex": 17, "startSec": 340, "endSec": 360}, {"lineId": "S19-19", "order": 18, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "🎵 Khi bụng em nóng ran, muốn hét lên thật to. Dừng lại ngay một chút, xòe bàn tay nhỏ ra! 🎵", "audio": {"$artifact": {"id": "art_3f77fa85e286", "kind": "audio", "uri": "assets/3f77fa85e286a7c321f1641841af76b4ed182b72a84f27891aa6c4644abdaa52.wav", "mime": "audio/wav", "size": 323296, "hash": "sha256:3f77fa85e286a7c321f1641841af76b4ed182b72a84f27891aa6c4644abdaa52", "meta": {"width": null, "height": null, "duration": 7.33, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793968037_2140cd", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "🎵 Khi bụng em nóng ran, muốn hét lên thật to. Dừng lại ngay một chút, xòe bàn tay nhỏ ra! 🎵", "voiceId": "soc-nho", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T12:27:17Z"}}}, "durationSec": 7.33, "voiceId": "soc-nho", "shotId": "S19", "sceneIndex": 18, "startSec": 360, "endSec": 380}, {"lineId": "S21-21", "order": 20, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Đố bạn nhỏ nhé: Khi đang giận, chúng mình nên quát to hay nên xòe bàn tay năm ngón hít thở sâu nào? … Đúng rồi, xòe tay hít thở sâu nhé!", "audio": {"$artifact": {"id": "art_7102be02632f", "kind": "audio", "uri": "assets/7102be02632f7bb83b0da52372ffdce8f9b9f76563a947bfb9fde3be5c9b976d.wav", "mime": "audio/wav", "size": 470590, "hash": "sha256:7102be02632f7bb83b0da52372ffdce8f9b9f76563a947bfb9fde3be5c9b976d", "meta": {"width": null, "height": null, "duration": 10.67, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793968037_2140cd", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Đố bạn nhỏ nhé: Khi đang giận, chúng mình nên quát to hay nên xòe bàn tay năm ngón hít thở sâu nào? … Đúng rồi, xòe tay hít thở sâu nhé!", "voiceId": "soc-nho", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T12:27:17Z"}}}, "durationSec": 10.67, "voiceId": "soc-nho", "shotId": "S21", "sceneIndex": 20, "startSec": 400, "endSec": 420}, {"lineId": "S22-22", "order": 21, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Mun ơi, anh Bi xin lỗi vì lúc nãy đã quát to làm Mun sợ nhé! Anh em mình làm hòa nha!", "audio": {"$artifact": {"id": "art_3f77fa85e286", "kind": "audio", "uri": "assets/3f77fa85e286a7c321f1641841af76b4ed182b72a84f27891aa6c4644abdaa52.wav", "mime": "audio/wav", "size": 323296, "hash": "sha256:3f77fa85e286a7c321f1641841af76b4ed182b72a84f27891aa6c4644abdaa52", "meta": {"width": null, "height": null, "duration": 7.33, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793968037_2140cd", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Mun ơi, anh Bi xin lỗi vì lúc nãy đã quát to làm Mun sợ nhé! Anh em mình làm hòa nha!", "voiceId": "soc-nho", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T12:27:17Z"}}}, "durationSec": 7.33, "voiceId": "soc-nho", "shotId": "S22", "sceneIndex": 21, "startSec": 420, "endSec": 440}, {"lineId": "S25-25", "order": 24, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Cầm chong chóng ra ban công đón gió mát thôi Mun ơi! Nhìn chong chóng của hai anh em mình quay đẹp chưa kìa!", "audio": {"$artifact": {"id": "art_d632daecb4ab", "kind": "audio", "uri": "assets/d632daecb4ab19e0f93f179107f4bb4240d5b261217dd6fe33505d7b4fc6106f.wav", "mime": "audio/wav", "size": 352844, "hash": "sha256:d632daecb4ab19e0f93f179107f4bb4240d5b261217dd6fe33505d7b4fc6106f", "meta": {"width": null, "height": null, "duration": 8.0, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793968037_2140cd", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Cầm chong chóng ra ban công đón gió mát thôi Mun ơi! Nhìn chong chóng của hai anh em mình quay đẹp chưa kìa!", "voiceId": "soc-nho", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T12:27:17Z"}}}, "durationSec": 8.0, "voiceId": "soc-nho", "shotId": "S25", "sceneIndex": 24, "startSec": 480, "endSec": 500}, {"lineId": "S26-26", "order": 25, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Bạn nhỏ nhớ nhé, mỗi khi thấy bụng nóng ran muốn giận dỗi, hãy đọc ngay: 'Xòe tay hít sâu, núi lửa nguội mau!'", "audio": {"$artifact": {"id": "art_d632daecb4ab", "kind": "audio", "uri": "assets/d632daecb4ab19e0f93f179107f4bb4240d5b261217dd6fe33505d7b4fc6106f.wav", "mime": "audio/wav", "size": 352844, "hash": "sha256:d632daecb4ab19e0f93f179107f4bb4240d5b261217dd6fe33505d7b4fc6106f", "meta": {"width": null, "height": null, "duration": 8.0, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793968037_2140cd", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Bạn nhỏ nhớ nhé, mỗi khi thấy bụng nóng ran muốn giận dỗi, hãy đọc ngay: 'Xòe tay hít sâu, núi lửa nguội mau!'", "voiceId": "soc-nho", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T12:27:17Z"}}}, "durationSec": 8.0, "voiceId": "soc-nho", "shotId": "S26", "sceneIndex": 25, "startSec": 500, "endSec": 520}, {"lineId": "S28-28", "order": 27, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "🎵 'Xòe tay hít sâu, núi lửa nguội mau!' — Trái tim êm dịu lại, mình nói lời yêu thương! 🎵", "audio": {"$artifact": {"id": "art_c29e294cae01", "kind": "audio", "uri": "assets/c29e294cae01ecf835ed26afdb9a0773fab37ce9c53bb5fabecb6855c934848e.wav", "mime": "audio/wav", "size": 308744, "hash": "sha256:c29e294cae01ecf835ed26afdb9a0773fab37ce9c53bb5fabecb6855c934848e", "meta": {"width": null, "height": null, "duration": 7.0, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793968037_2140cd", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "🎵 'Xòe tay hít sâu, núi lửa nguội mau!' — Trái tim êm dịu lại, mình nói lời yêu thương! 🎵", "voiceId": "soc-nho", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T12:27:17Z"}}}, "durationSec": 7.0, "voiceId": "soc-nho", "shotId": "S28", "sceneIndex": 27, "startSec": 540, "endSec": 560}, {"lineId": "S29-29", "order": 28, "characterId": "soc_nho", "speaker": "Sóc Bi", "text": "Cảm ơn bạn nhỏ đã đến nhà cây chơi với anh em Bi và Mun hôm nay nhé! Chúc bạn nhỏ luôn vui vẻ và ngoan ngoãn!", "audio": {"$artifact": {"id": "art_f60dcddb714e", "kind": "audio", "uri": "assets/f60dcddb714e325603a2ac575fc7db6d29fceb56721863d9882c1f314633f00f.wav", "mime": "audio/wav", "size": 396944, "hash": "sha256:f60dcddb714e325603a2ac575fc7db6d29fceb56721863d9882c1f314633f00f", "meta": {"width": null, "height": null, "duration": 9.0, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_soc_nho", "runId": "run_1793968037_2140cd", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Cảm ơn bạn nhỏ đã đến nhà cây chơi với anh em Bi và Mun hôm nay nhé! Chúc bạn nhỏ luôn vui vẻ và ngoan ngoãn!", "voiceId": "soc-nho", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T12:27:17Z"}}}, "durationSec": 9.0, "voiceId": "soc-nho", "shotId": "S29", "sceneIndex": 28, "startSec": 560, "endSec": 580}]}, "portSigs": {"character": "dae3176f99d58337c0f8f5b5a59a09dcff1a061073547a975434ce2a2bc6945f", "reference_images": "d38ee872c11d522c08f54fc06a44b5f80d8a1745c1b0d3e3e1baac55778c8bf7", "voice": "4b134d51a2a24197f226f824458cefab1b003fe5793d5a5b560a28d1b72bb303"}}