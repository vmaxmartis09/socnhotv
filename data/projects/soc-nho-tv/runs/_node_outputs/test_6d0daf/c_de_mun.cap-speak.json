{"nodeId": "c_de_mun", "capability": "speak", "key": "2d11b650fda3fbd76283be394c968ba439a49c31cb53bcf9b526979cf543f9c6", "costUsd": 0.0, "savedAt": "2026-11-06T12:27:17Z", "outputs": {"voice": [{"lineId": "S02-2", "order": 1, "characterId": "de_mun", "speaker": "Dê Mun", "text": "Anh Bi ơi! Mun mang quả bóng vải sang chơi với anh Bi nè!", "audio": {"$artifact": {"id": "art_d7de370bca1c", "kind": "audio", "uri": "assets/d7de370bca1c5d54ce2085616ceac8fd9d93df1a00a3e043e902a8aae184e5ac.wav", "mime": "audio/wav", "size": 205990, "hash": "sha256:d7de370bca1c5d54ce2085616ceac8fd9d93df1a00a3e043e902a8aae184e5ac", "meta": {"width": null, "height": null, "duration": 4.67, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_de_mun", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Anh Bi ơi! Mun mang quả bóng vải sang chơi với anh Bi nè!", "voiceId": "vn-be-04", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 4.67, "voiceId": "vn-be-04", "shotId": "S02", "sceneIndex": 1, "startSec": 20, "endSec": 40}, {"lineId": "S06-6", "order": 5, "characterId": "de_mun", "speaker": "Dê Mun", "text": "Oa, ngôi sao đẹp thích nhắm! Cho Mun lại gần xem ngôi sao với anh Bi ơi!", "audio": {"$artifact": {"id": "art_56c77de9f2bd", "kind": "audio", "uri": "assets/56c77de9f2bdf23187ef92d40bc5d03012b10a98fda1e36787b26d1ff4fadaf1.wav", "mime": "audio/wav", "size": 250090, "hash": "sha256:56c77de9f2bdf23187ef92d40bc5d03012b10a98fda1e36787b26d1ff4fadaf1", "meta": {"width": null, "height": null, "duration": 5.67, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_de_mun", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Oa, ngôi sao đẹp thích nhắm! Cho Mun lại gần xem ngôi sao với anh Bi ơi!", "voiceId": "vn-be-04", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 5.67, "voiceId": "vn-be-04", "shotId": "S06", "sceneIndex": 5, "startSec": 100, "endSec": 120}, {"lineId": "S09-9", "order": 8, "characterId": "de_mun", "speaker": "Dê Mun", "text": "Anh Bi ơi… Mun không cố ý đâu… Mun nhặt ngôi sao trả cho anh Bi nè…", "audio": {"$artifact": {"id": "art_56c77de9f2bd", "kind": "audio", "uri": "assets/56c77de9f2bdf23187ef92d40bc5d03012b10a98fda1e36787b26d1ff4fadaf1.wav", "mime": "audio/wav", "size": 250090, "hash": "sha256:56c77de9f2bdf23187ef92d40bc5d03012b10a98fda1e36787b26d1ff4fadaf1", "meta": {"width": null, "height": null, "duration": 5.67, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_de_mun", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "Anh Bi ơi… Mun không cố ý đâu… Mun nhặt ngôi sao trả cho anh Bi nè…", "voiceId": "vn-be-04", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 5.67, "voiceId": "vn-be-04", "shotId": "S09", "sceneIndex": 8, "startSec": 160, "endSec": 180}, {"lineId": "S20-20", "order": 19, "characterId": "de_mun", "speaker": "Dê Mun", "text": "🎵 Hít vào ngửi hoa thơm, thở ra chong chóng quay! 'Xòe tay hít sâu, núi lửa nguội mau!' 🎵", "audio": {"$artifact": {"id": "art_d5ddc8139e6d", "kind": "audio", "uri": "assets/d5ddc8139e6d9ddd430b007d39e11124f38846f6aa34fe37402e09b2b991dded.wav", "mime": "audio/wav", "size": 294190, "hash": "sha256:d5ddc8139e6d9ddd430b007d39e11124f38846f6aa34fe37402e09b2b991dded", "meta": {"width": null, "height": null, "duration": 6.67, "fps": null, "aspect": null}, "provenance": {"nodeId": "c_de_mun", "runId": "run_1793940773_f32f14", "provider": "mock", "model": "mock-omnivoice-v1", "params": {"text": "🎵 Hít vào ngửi hoa thơm, thở ra chong chóng quay! 'Xòe tay hít sâu, núi lửa nguội mau!' 🎵", "voiceId": "vn-be-04", "tempo": 1.0}, "inputHashes": [], "costUsd": 0.0, "createdAt": "2026-11-06T04:52:53Z"}}}, "durationSec": 6.67, "voiceId": "vn-be-04", "shotId": "S20", "sceneInde