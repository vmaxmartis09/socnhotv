# Virtual Environments & Caches
.venv/
tool/.venv/
__pycache__/
*.py[cod]
*.egg-info/
.env
.env.local
.env.*.local

# Voice Vault: prompt cache và audio lớn không đưa vào git
data/shared/voice_vault/*/*.pt
data/shared/voice_vault/*/*.wav
data/shared/voice_vault/*/*.npy
data/shared/voice_vault/*/*.mp3
assets/voice_vault/*/*.pt
assets/voice_vault/*/*.wav
assets/voice_vault/*/*.npy
assets/voice_vault/*/*.mp3

# Project sensitive & transient data (Accounts, Raw dumps, Shots)
data/projects/*/accounts/*
!data/projects/*/accounts/.gitkeep
data/projects/*/shots/*
!data/projects/*/shots/.gitkeep
data/projects/*/runs/*
!data/projects/*/runs/.gitkeep
data/projects/*/output/*
!data/projects/*/output/.gitkeep

# Exclude large tool binaries (>25MB)
data/shared/models/ffmpeg-bin/

# Keep all project data, characters, content, assets, templates
!data/projects/*/characters/**
!data/projects/*/content/**
!data/projects/*/assets/**
!data/projects/*/publishing/**
!data/projects/*/analytics/**
!data/shared/templates/**
!data/shared/voice_vault/**

# Third-party integrations
integrations/OmniVoice/
tool/integrations/OmniVoice/

# Node, macOS, build artifacts
node_modules/
dist/
.DS_Store
.next/
.next-dev/
.next-build/
out/

# Video / Audio heavy binaries
*.mp4
*.mov
*.webm
*.tsbuildinfo

# Temporary scratchpad
.taste-skill/
tool/dashboard/.taste-skill/
scratch/
tool/scratch/
graphify-out/
*.hf-transaction*
*-lock
*-lock/
